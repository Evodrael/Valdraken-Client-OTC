MiniBotCombatAttackItemDropDownEntry < UIWidget
  image-source: /images/ui/containerslot
  image-border: 3
  size: 34 34

  UIItem
    id: item
    anchors.centerIn: parent
    size: 32 32
    phantom: true
    virtual: true

  UIWidget
    id: block
    size: 34 34
    anchors.fill: parent
    image-source: /resources/minibot_spell_block
    phantom: true
    visible: false

UIWidget
  anchors.fill: parent

  UIWidget
    id: settings
    image-source: /images/ui/window_light
    image-border-left: 2
    image-border-right: 2
    image-border-top: 25
    image-border-bottom: 3
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    Label
      id: title
      !text: 'Attack options'
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      text-horizontal-auto-resize: true
      margin-top: 2
      phantom: true
      color: #909090

    UIWidget
      id: attackPanel
      height: 165
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 24
      margin-left: 5
      margin-right: 5
      image-source: /resources/button_phantom
      image-clip: 0 46 22 23
      image-border: 3

      # Botao master ON/OFF do Auto Attack. Os 4 modos abaixo sao mutuamente
      # exclusivos (CircularCheckBox = visual de radio) e ficam sempre visiveis,
      # habilitados apenas enquanto este botao estiver em ON.
      #
      # Os anchors dos modos sao explicitos em vez de 'prev.bottom': os icones de
      # ajuda ficam intercalados entre eles, e 'prev' pega o irmao anterior no
      # arquivo, o que quebraria a corrente.
      UIWidget
        id: autoAttackLabel
        anchors.left: parent.left
        anchors.verticalCenter: autoAttack.verticalCenter
        !text: 'Auto Attack'
        text-horizontal-auto-resize: true
        color: #C0C0C0
        margin-left: 6
        phantom: true

      ButtonBox
        id: autoAttack
        anchors.right: parent.right
        anchors.top: parent.top
        margin-top: 4
        margin-right: 6
        size: 54 20
        !text: 'OFF'
        @onCheckChange: |
          modules.game_minibot.callMethod('onAutoAttackCheckChange', self)

      UIWidget
        id: autoAttackHelp
        anchors.verticalCenter: autoAttack.verticalCenter
        anchors.right: autoAttack.left
        margin-right: 8
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        opacity: 1
        phantom: false
        !tooltip: 'Turns automatic target selection on and off. While ON, the system picks the target using the option checked below and switches whenever a better target shows up.'

        $disabled:
          opacity: 0.5
          phantom: true

      CircularCheckBox
        id: closest
        anchors.left: parent.left
        anchors.top: autoAttack.bottom
        !text: 'Closest creature'
        text-horizontal-auto-resize: true
        color: #C0C0C0
        margin-top: 8
        margin-left: 12
        text-offset: 16 -2
        @onCheckChange: |
          modules.game_minibot.callMethod('onAttackOptionChange', self)

      UIWidget
        id: attackClosestHelp
        anchors.verticalCenter: closest.verticalCenter
        anchors.right: parent.right
        margin-right: 8
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        opacity: 1
        phantom: false
        !tooltip: 'Attacks the creature nearest to your character. Diagonals count as 1 SQM, matching the game reach.'

        $disabled:
          opacity: 0.5
          phantom: true

      CircularCheckBox
        id: lowest
        anchors.left: parent.left
        anchors.top: closest.bottom
        !text: 'Lowest HP creature'
        text-horizontal-auto-resize: true
        color: #C0C0C0
        margin-top: 5
        margin-left: 12
        text-offset: 16 -2
        @onCheckChange: |
          modules.game_minibot.callMethod('onAttackOptionChange', self)

      UIWidget
        id: attackLowestHelp
        anchors.verticalCenter: lowest.verticalCenter
        anchors.right: parent.right
        margin-right: 8
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        opacity: 1
        phantom: false
        !tooltip: 'Attacks the creature on screen with the lowest health percentage. Creatures behind walls or invisible are ignored.'

        $disabled:
          opacity: 0.5
          phantom: true

      CircularCheckBox
        id: highest
        anchors.left: parent.left
        anchors.top: lowest.bottom
        !text: 'Highest HP creature'
        text-horizontal-auto-resize: true
        color: #C0C0C0
        margin-top: 5
        margin-left: 12
        text-offset: 16 -2
        @onCheckChange: |
          modules.game_minibot.callMethod('onAttackOptionChange', self)

      UIWidget
        id: attackHighestHelp
        anchors.verticalCenter: highest.verticalCenter
        anchors.right: parent.right
        margin-right: 8
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        opacity: 1
        phantom: false
        !tooltip: 'Attacks the creature on screen with the highest health percentage. Creatures behind walls or invisible are ignored.'

        $disabled:
          opacity: 0.5
          phantom: true

      CircularCheckBox
        id: ranged
        anchors.left: parent.left
        anchors.top: highest.bottom
        !text: 'Ranged attack'
        text-horizontal-auto-resize: true
        color: #C0C0C0
        margin-top: 5
        margin-left: 12
        text-offset: 16 -2
        @onCheckChange: |
          modules.game_minibot.callMethod('onAttackOptionChange', self)

      UIWidget
        id: attackRangedHelp
        anchors.verticalCenter: ranged.verticalCenter
        anchors.right: parent.right
        margin-right: 8
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        opacity: 1
        phantom: false
        !tooltip: 'For paladins: picks the target where the area arrow hits the most creatures at once. On a tie, prefers the lowest health. Without area ammo equipped it behaves as "closest creature".'

        $disabled:
          opacity: 0.5
          phantom: true

      # Modificador (nao e um dos modos): atua ANTES do criterio do modo, sem
      # substituir ele. Por isso e um QtCheckBox e nao um CircularCheckBox.
      QtCheckBox
        id: preferAttacker
        anchors.left: parent.left
        anchors.top: ranged.bottom
        !text: 'Prioritize whoever is attacking me'
        text-horizontal-auto-resize: true
        color: #C0C0C0
        margin-top: 8
        margin-left: 12
        text-offset: 16 -2
        @onCheckChange: |
          modules.game_minibot.callMethod('onAttackTuningChange', self)

      UIWidget
        id: preferAttackerHelp
        anchors.verticalCenter: preferAttacker.verticalCenter
        anchors.right: parent.right
        margin-right: 8
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        opacity: 1
        phantom: false
        !tooltip: 'Applies on top of the selected mode. The Tibia protocol does not tell the client who is targeting you, so this is a heuristic: adjacent creatures, plus whoever fired a missile that landed on you in the last 3 seconds.'

        $disabled:
          opacity: 0.5
          phantom: true

      # O rotulo posiciona a linha (ancora no parent + na linha de cima) e o campo
      # se pendura NELE. A dependencia tem que ser de uma unica direcao: rotulo
      # ancorado em maxDistance.verticalCenter com maxDistance ancorado em
      # maxDistanceLabel.right e um CICLO -- o UIAnchorLayout detecta, recusa o
      # layout e cospe "recursively anchored to itself" a cada reavaliacao.
      UIWidget
        id: maxDistanceLabel
        anchors.left: parent.left
        anchors.top: preferAttacker.bottom
        !text: 'Max distance (SQM):'
        text-horizontal-auto-resize: true
        color: #C0C0C0
        margin-left: 12
        margin-top: 9
        phantom: true

        $disabled:
          opacity: 0.5

      TextEdit
        id: maxDistance
        anchors.left: maxDistanceLabel.right
        anchors.verticalCenter: maxDistanceLabel.verticalCenter
        margin-left: 6
        width: 32
        text-only-number: true
        !placeholder: '10'
        color: #C0C0C0
        @onTextChange: |
          modules.game_minibot.callMethod('validateAttackNumber', self)

      UIWidget
        id: maxDistanceHelp
        anchors.verticalCenter: maxDistance.verticalCenter
        anchors.right: parent.right
        margin-right: 8
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        opacity: 1
        phantom: false
        !tooltip: 'Creatures farther than this are never targeted, so the character does not walk across the screen chasing something. 1 to 10; 10 covers the whole screen (no practical limit).'

        $disabled:
          opacity: 0.5
          phantom: true

      # Mesma regra do par acima: rotulo posiciona, campo se pendura nele.
      UIWidget
        id: minAoeLabel
        anchors.left: parent.left
        anchors.top: maxDistance.bottom
        !text: 'Min. targets for area:'
        text-horizontal-auto-resize: true
        color: #C0C0C0
        margin-left: 12
        margin-top: 7
        phantom: true

        $disabled:
          opacity: 0.5

      TextEdit
        id: minAoeTargets
        anchors.left: minAoeLabel.right
        anchors.verticalCenter: minAoeLabel.verticalCenter
        margin-left: 6
        width: 32
        text-only-number: true
        !placeholder: '1'
        color: #C0C0C0
        @onTextChange: |
          modules.game_minibot.callMethod('validateAttackNumber', self)

      UIWidget
        id: minAoeHelp
        anchors.verticalCenter: minAoeTargets.verticalCenter
        anchors.right: parent.right
        margin-right: 8
        color: #C0C0C0
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        opacity: 1
        phantom: false
        !tooltip: 'Only used by "Ranged attack": if the best aim point would hit fewer creatures than this, the system falls back to the lowest HP target instead of aiming at a distant cluster. 1 disables the check.'

        $disabled:
          opacity: 0.5
          phantom: true

    UIWidget
      id: ammoRefill
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 5
      margin-right: 5
      image-source: /resources/button_phantom
      image-clip: 0 46 22 23
      image-border: 3
      padding: 5
      height: 75

      QtCheckBox
        id: check
        anchors.left: parent.left
        anchors.top: parent.top
        text-horizontal-auto-resize: true
        !text: 'Ammo Refill'
        text-offset: 15 -2
        color: #C0C0C0
        @onCheckChange: |
          modules.game_minibot.callMethod('onAmmoRefillChange', self)

      UIWidget
        id: frameBackground
        image-source: /resources/icon_source_frame_minibot
        size: 38 44
        anchors.left: parent.left
        anchors.top: check.bottom
        margin-left: 15
        margin-top: 5
        phantom: true

      UIWidget
        id: frameColor
        anchors.centerIn: frameBackground
        background-color: white
        opacity: 0.05
        size: 32 32
        phantom: true

      UIItem
        id: item
        size: 32 32
        phantom: true
        anchors.centerIn: frameBackground
        visible: false
        virtual: true
        opacity: 0.3

      UIWidget
        id: block
        anchors.centerIn: item
        size: 34 34
        image-source: /resources/minibot_spell_block
        phantom: true
        visible: true

      UIWidget
        id: name
        anchors.left: frameBackground.right
        anchors.verticalCenter: frameBackground.verticalCenter
        font: verdana-11px-antialised
        text-horizontal-auto-resize: true
        color: white
        margin-left: 7
        opacity: 0.3

      UIWidget
        id: tooltipLabel
        anchors.right: parent.right
        anchors.verticalCenter: check.verticalCenter
        color: #C0C0C0
        margin-right: 5
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        !tooltip: 'If a selected ammo is found on your inventory, the system automatically try to move periodically.'

  UIWidget
    id: dropDownCatcher
    anchors.fill: parent
    visible: false

  ScrollablePanel
    id: dropDownMenu
    padding-right: 14
    image-source: /resources/border_minibot_dropdown
    image-border: 5
    vertical-scrollbar: dropDownMenuScrollBar
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 48
    margin-top: 295
    size: 295 98
    padding: 8
    visible: false
    layout:
      type: grid
      cell-size: 34 34
      cell-spacing: 4
      flow: true

  VerticalScrollBar
    id: dropDownMenuScrollBar
    anchors.top: dropDownMenu.top
    anchors.bottom: dropDownMenu.bottom
    anchors.right: dropDownMenu.right
    margin-top: 2
    margin-right: 2
    margin-bottom: 2
    step: 32
    pixels-scroll: true
    visible: false
