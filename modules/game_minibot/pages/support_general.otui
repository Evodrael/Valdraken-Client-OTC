MiniBotSupportGeneralItemDropDownEntry < UIWidget
  image-source: /images/ui/containerslot
  image-border: 3
  size: 34 34

  UIItem
    id: item
    anchors.centerIn: parent
    size: 32 32
    phantom: true
    virtual: true

  UIWidget
    id: block
    size: 34 34
    anchors.fill: parent
    image-source: /resources/minibot_spell_block
    phantom: true
    visible: false

UIWidget
  anchors.fill: parent

  UIWidget
    id: panel
    image-source: /images/ui/window_light
    image-border-left: 2
    image-border-right: 2
    image-border-top: 25
    image-border-bottom: 3
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    Label
      id: title
      !text: 'General'
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      text-horizontal-auto-resize: true
      margin-top: 2
      phantom: true
      color: #909090

    UIWidget
      id: changeGold
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 22
      margin-left: 5
      margin-right: 5
      image-source: /resources/button_phantom
      image-clip: 0 46 22 23
      image-border: 3
      padding: 5
      height: 26

      QtCheckBox
        id: check
        anchors.left: parent.left
        anchors.top: parent.top
        text-horizontal-auto-resize: true
        !text: 'Auto change gold'
        text-offset: 15 -2
        color: #C0C0C0
        @onCheckChange: |
          modules.game_minibot.callMethod('onChangeGoldChange', self)

      UIWidget
        id: help
        anchors.right: parent.right
        anchors.verticalCenter: check.verticalCenter
        color: #C0C0C0
        margin-right: 5
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        !tooltip: 'All your gold/platinum coins will be automatically transformed into their most valuable version when it stacks into 100 units.'

    UIWidget
      id: autoMount
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 5
      margin-right: 5
      image-source: /resources/button_phantom
      image-clip: 0 46 22 23
      image-border: 3
      padding: 5
      height: 26

      QtCheckBox
        id: check
        anchors.left: parent.left
        anchors.top: parent.top
        text-horizontal-auto-resize: true
        !text: 'Auto mount'
        text-offset: 15 -2
        color: #C0C0C0
        @onCheckChange: |
          modules.game_minibot.callMethod('onAutoMountChange', self)

      UIWidget
        id: help
        anchors.right: parent.right
        anchors.verticalCenter: check.verticalCenter
        color: #C0C0C0
        margin-right: 5
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        !tooltip: 'Ao sair de uma Protection Zone, o Assistente ira tentar manter sempre a montaria ativa no seu personagem.'

    UIWidget
      id: autoFishing
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 5
      margin-right: 5
      image-source: /resources/button_phantom
      image-clip: 0 46 22 23
      image-border: 3
      padding: 5
      height: 75

      QtCheckBox
        id: check
        anchors.left: parent.left
        anchors.top: parent.top
        text-horizontal-auto-resize: true
        !text: 'Auto fishing'
        text-offset: 15 -2
        color: #C0C0C0
        @onCheckChange: |
          modules.game_minibot.callMethod('onAutoFishingChange', self)

      UIWidget
        id: frameBackground
        image-source: /resources/icon_source_frame_minibot
        size: 38 44
        anchors.left: parent.left
        anchors.top: check.bottom
        margin-left: 15
        margin-top: 5
        phantom: true

      UIWidget
        id: frameColor
        anchors.centerIn: frameBackground
        background-color: white
        opacity: 0.05
        size: 32 32
        phantom: true

      UIItem
        id: rod
        size: 32 32
        phantom: true
        anchors.centerIn: frameBackground
        virtual: true
        opacity: 0.3

      UIWidget
        id: frameBackground2
        image-source: /resources/icon_source_frame_minibot
        size: 38 44
        anchors.left: frameBackground.right
        anchors.verticalCenter: frameBackground.verticalCenter
        margin-left: 10
        phantom: true

      UIWidget
        id: frameColor2
        anchors.centerIn: frameBackground2
        background-color: white
        opacity: 0.05
        size: 32 32
        phantom: true

      UIItem
        id: spot
        size: 32 32
        phantom: true
        anchors.centerIn: frameBackground2
        virtual: true
        opacity: 0.3

      UIWidget
        id: name
        anchors.left: frameBackground2.right
        anchors.verticalCenter: frameBackground2.verticalCenter
        font: verdana-11px-antialised
        text-horizontal-auto-resize: true
        color: #C0C0C0
        margin-left: 7
        opacity: 0.3

      UIWidget
        id: help
        anchors.right: parent.right
        anchors.verticalCenter: check.verticalCenter
        color: #C0C0C0
        margin-right: 5
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        !tooltip: 'Uses the Mechanical Fishing Rod from your backpack on a Bath Tub on your screen every 2 seconds.'

    UIWidget
      id: autoTraining
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 5
      margin-right: 5
      image-source: /resources/button_phantom
      image-clip: 0 46 22 23
      image-border: 3
      padding: 5
      height: 85

      QtCheckBox
        id: check
        anchors.left: parent.left
        anchors.top: parent.top
        text-horizontal-auto-resize: true
        !text: 'Auto training'
        text-offset: 15 -2
        color: #C0C0C0
        @onCheckChange: |
          modules.game_minibot.callMethod('onAutoTrainingChange', self)

      UIWidget
        id: frameBackground1
        image-source: /resources/icon_source_frame_minibot
        size: 38 44
        anchors.left: parent.left
        anchors.top: check.bottom
        margin-left: 15
        margin-top: 15
        phantom: true

      UIWidget
        id: frameColor1
        anchors.centerIn: frameBackground1
        background-color: white
        opacity: 0.05
        size: 32 32
        phantom: true

      UIItem
        id: item1
        size: 32 32
        phantom: true
        anchors.centerIn: frameBackground1
        visible: false
        virtual: true
        opacity: 0.3

      UIWidget
        id: block1
        anchors.centerIn: item1
        size: 34 34
        image-source: /resources/minibot_spell_block
        phantom: true
        visible: true

      UIWidget
        id: frameBackground2
        image-source: /resources/icon_source_frame_minibot
        size: 38 44
        anchors.right: parent.right
        anchors.top: check.bottom
        margin-right: 25
        margin-top: 15
        phantom: true

      UIWidget
        id: frameColor2
        anchors.centerIn: frameBackground2
        background-color: white
        opacity: 0.05
        size: 32 32
        phantom: true

      UIItem
        id: item2
        size: 64 64
        phantom: true
        anchors.right: frameBackground2.right
        anchors.bottom: frameBackground2.bottom
        visible: false
        virtual: true
        opacity: 0.3
        margin-right: 6
        margin-bottom: 12

      UIWidget
        id: effects
        anchors.left: frameBackground1.left
        anchors.top: frameBackground1.top
        anchors.bottom: frameBackground1.bottom
        anchors.right: frameBackground2.right
        phantom: true

      UIWidget
        id: help
        anchors.right: parent.right
        anchors.verticalCenter: check.verticalCenter
        color: #C0C0C0
        margin-right: 5
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        !tooltip: 'You can select a specific exercise weapon and a dummy type, so that the Assistant will automatically start training.'

    UIWidget
      id: autoBless
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 5
      margin-right: 5
      image-source: /resources/button_phantom
      image-clip: 0 46 22 23
      image-border: 3
      padding: 5
      height: 26

      QtCheckBox
        id: check
        anchors.left: parent.left
        anchors.top: parent.top
        text-horizontal-auto-resize: true
        !text: 'Auto bless'
        text-offset: 15 -2
        color: #C0C0C0
        @onCheckChange: |
          modules.game_minibot.callMethod('onAutoBlessChange', self)

      UIWidget
        id: help
        anchors.right: parent.right
        anchors.verticalCenter: check.verticalCenter
        color: #C0C0C0
        margin-right: 5
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        !tooltip: 'When you die, the Assistant will automatically send the !bless command on your next login with this character.'

    UIWidget
      id: autoFollow
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 5
      margin-right: 5
      image-source: /resources/button_phantom
      image-clip: 0 46 22 23
      image-border: 3
      padding: 5
      height: 26

      QtCheckBox
        id: check
        anchors.left: parent.left
        anchors.top: parent.top
        text-horizontal-auto-resize: true
        !text: 'Auto follow'
        text-offset: 15 -2
        color: #C0C0C0
        @onCheckChange: |
          modules.game_minibot.callMethod('onAutoFollowChange', self)

      TextEdit
        id: name
        anchors.verticalCenter: check.verticalCenter
        anchors.right: help.left
        margin-right: 8
        width: 160
        !placeholder: 'Type player name'
        placeholder-font: cipsoftFont
        color: #C0C0C0
        @onTextChange: |
          modules.game_minibot.callMethod('onAutoFollowNameChange', self)

      UIWidget
        id: help
        anchors.right: parent.right
        anchors.verticalCenter: check.verticalCenter
        color: #C0C0C0
        margin-right: 5
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        !tooltip: 'The Assistant will keep following the player with this name whenever they are on your screen.'

    UIWidget
      id: autoReconnect
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 5
      margin-right: 5
      image-source: /resources/button_phantom
      image-clip: 0 46 22 23
      image-border: 3
      padding: 5
      height: 26

      QtCheckBox
        id: check
        anchors.left: parent.left
        anchors.top: parent.top
        text-horizontal-auto-resize: true
        !text: 'Auto reconnect'
        text-offset: 15 -2
        color: #C0C0C0
        @onCheckChange: |
          modules.game_minibot.callMethod('onAutoReconnectChange', self)

      UIWidget
        id: help
        anchors.right: parent.right
        anchors.verticalCenter: check.verticalCenter
        color: #C0C0C0
        margin-right: 5
        image-source: /images/icons/show_gui_help_grey
        size: 12 12
        !tooltip: 'If the connection to the game server drops, the client logs this character back in automatically. Only works while the client stays open, and it does not act on a manual logout.'

  UIWidget
    id: dropDownCatcher
    anchors.fill: parent
    visible: false

  ScrollablePanel
    id: dropDownMenu
    padding-right: 14
    image-source: /resources/border_minibot_dropdown
    image-border: 5
    vertical-scrollbar: dropDownMenuScrollBar
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 48
    margin-top: 264
    size: 295 98
    padding: 8
    visible: false
    layout:
      type: grid
      cell-size: 34 34
      cell-spacing: 4
      flow: true

  VerticalScrollBar
    id: dropDownMenuScrollBar
    anchors.top: dropDownMenu.top
    anchors.bottom: dropDownMenu.bottom
    anchors.right: dropDownMenu.right
    margin-top: 2
    margin-right: 2
    margin-bottom: 2
    step: 32
    pixels-scroll: true
    visible: false
