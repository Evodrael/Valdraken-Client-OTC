TopButton < UIButton
  size: 26 26
  image-clip: 0 0 26 26
  image-border: 3
  image-color: #ffffffff
  icon-color: #ffffffff
  icon-clip: 0 0 20 20
  
  $on:
    icon-clip: 0 20 20 20

  $pressed:
    image-clip: 52 0 26 26
    icon-clip: 0 20 20 20

  $disabled:
    image-color: #ffffff44
    icon-color: #ffffff44

TopToggleButton < UIButton
  size: 20 20
  image-source: /images/ui/button_top
  image-clip: 0 0 26 26
  image-color: #ffffffff
  image-border: 3
  icon-clip: 0 0 20 20
  icon-color: #ffffffff
  
  $on:
    icon-clip: 0 20 20 20

  $hover !disabled:
    image-clip: 26 0 26 26

  $pressed:
    image-clip: 52 0 26 26
    icon-clip: 0 20 20 20

  $disabled:
    image-color: #ffffff44
    icon-color: #ffffff44
    
TopMenuButtonsPanel < Panel
  layout:
    type: horizontalBox
    spacing: 4
    fit-children: true
  padding: 6 4

TopMenuPanel < Panel
  height: 36
  image-source: /images/ui/panel_top
  image-repeated: true
  image-border: 3
  image-border-top: 0
  focusable: false

TopMenuFrameCounterLabel < Label
  font: verdana-11px-rounded
  color: white
  margin-top: 4
  margin-left: 5

TopMenuPingLabel < Label
  font: verdana-11px-rounded

TopMenu < TopMenuPanel
  id: topMenu
  width: 800
  height: 24
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.top: parent.top
  &hideIngame: true
  &reverseButtons: true

  UIWidget
    id: twitch
    size: 47 16
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 8
    image-source: /images/ui/icon-twitch
    !tooltip: tr('Streamers do Valdraken ao vivo')
  UIWidget
    id: twitchStreamsIcon
    size: 11 7
    anchors.top: parent.top
    anchors.left: twitch.right
    margin-top: 4
    margin-left: 5
    image-source: /images/ui/icon-streamers
    phantom: true
  Label
    id: twitchStreams
    anchors.verticalCenter: twitchStreamsIcon.verticalCenter
    anchors.left: twitchStreamsIcon.right
    margin-left: 4
    text: 0
    font: $var-cip-font
    color: $var-text-cip-color
    text-auto-resize: true
    phantom: true
  UIWidget
    id: twitchViewersIcon
    size: 11 7
    anchors.top: twitchStreamsIcon.bottom
    anchors.left: twitch.right
    margin-top: 3
    margin-left: 5
    image-source: /images/ui/icon-viewers
    phantom: true
  Label
    id: twitchViewers
    anchors.verticalCenter: twitchViewersIcon.verticalCenter
    anchors.left: twitchViewersIcon.right
    margin-left: 4
    text: 0
    font: $var-cip-font
    color: $var-text-cip-color
    text-auto-resize: true
    phantom: true

  UIWidget
    id: discord
    size: 18 18
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: twitch.right
    margin-left: 62
    image-source: /images/ui/discord
  UIWidget
    id: discordLabel
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: discord.right
    margin-left: 5
    text: "Join Discord"
    font: $var-cip-font
    color: $var-text-cip-color
    text-auto-resize: true
    text-offset: 0 -1
    $hover !pressed:
      color: $var-text-cip-color-highlight
    $pressed:
      color: $var-text-cip-color-green

  TopMenuButtonsPanel
    id: rightButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: discordLabel.right
    padding: 2 4

  TopMenuButtonsPanel
    id: rightGameButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    padding: 2 4
    visible: false

  Label
    id: onlineLabel
    !text: tr('Updating...')
    anchors.verticalCenter: parent.verticalCenter
    anchors.horizontalCenter: parent.horizontalCenter
    text-align: center
    margin-left: 12
    text-auto-resize: true

  UIWidget
    id: peopleIcon
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: onlineLabel.left
    margin-right: 6
    size: 11 14
    image-source: /images/ui/people
    phantom: true

  TopMenuButtonsPanel
    id: leftButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    padding: 2 4

  TopMenuButtonsPanel
    id: leftGameButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: prev.left
    padding: 2 4
    visible: false
